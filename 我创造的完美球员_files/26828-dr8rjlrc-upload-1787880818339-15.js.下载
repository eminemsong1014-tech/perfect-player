讨论你们还能不能留在淘汰赛里。队友只需要你把第一个防守回合站住，把第一个篮板保护下来，再把第一个简单的传球送到队友最舒服的位置。重新站起来不需要一句豪言，只需要五个人同时向前迈一步。':'小组排名还没有给出答案，但每一个胜场都开始变得具体。安哥拉不会替你们完成晋级计算，家人、队友和看台也不会替你们把这一场打完。你们必须自己把该拿的一场拿下来。'}\n    if(stage==='小组赛'&&opponent==='德国'&&previousGame&&previousGame.opponent==='安哥拉'&&previousRecord){conditional=previousRecord.won?'一场胜利让呼吸重新顺了起来，但德国不会允许你们把上一场的节奏带进今晚。你们需要证明，安哥拉之后留下的不只是情绪，还有能够重复执行的东西。真正的成长不是赢完之后更兴奋，而是在下一场更难的比赛里仍然知道自己该站在哪里。':'本来应该止住的下坠没有停下来。现在每一个回合都带着排名的重量，德国会把这种紧张拖到最后一秒。你可以感到疲惫，也可以承认害怕，但不能让这种感觉替你决定下一次回防的方向。'}\n    if(stage==='小组赛'&&opponent==='希腊')conditional=wins>=3?'你们已经把主动权握在手里，但希腊不会因为排名计算而放松。今晚不是为了证明前四场侥幸有效，而是要证明这支球队能在压力最大的时候仍然按照自己的方式打球。看台上的人已经开始计算下一轮，可你们要做的只有一件事：让队友相信，最累的时候仍然有人会跑到应该出现的位置。':'这是小组赛最后一场，已经没有下一场可以替你们修正答案。你们现在拥有一次把今晚打成自己答案的机会。无论最后记分牌写下什么，终场哨响之前，都不要让任何一个队友独自站在压力里。';\n    var knockout={\n      '澳大利亚':'澳大利亚把更强的身体对抗带到你们面前。篮下的每一次碰撞都会提醒你，没有哪个回合只是试探；轮换深度会把压力一层层推高，只有五个人仍愿意为同一个篮板同时起跳，比赛才不会只属于对手的节奏。',\n      '阿根廷':'阿根廷把冠军球队的默契带到你们面前。五个人只要同时读懂一个防守，比赛就会突然改变方向。姚明会被夹击，弱侧会出现短暂的空位，你们必须在那一秒里决定，是让一个人承担，还是让整支球队把答案传出来。',\n      '立陶宛':'立陶宛这个名字留在国家队的录像室里。暂停、回防、最后几分钟，每个人都知道它为什么会留下来。今天没有人需要重复任何故事，球在场上，时间在走，旧账只能由这五个人用一个个不后退的回合回答。',\n      '美国':'美国队又一次站在灯光下，他们的每一次换防都带着证明自己的急迫感。你们要做的不是追逐他们的名字，而是在最响的欢呼里仍然看见队友的空位，让每一次传球都成为自己的回答。',\n      '西班牙':'西班牙的传导会把防守拖向每一个角落。保罗·加索尔站住内线，其他人不断移动，像一支不会因为比分变化就失去耐心的球队。你们必须守住自己的呼吸，把包夹后的第一传送到队友手里。'\n    }[opponent]||'淘汰赛的灯光落下来，球馆里每一次呼吸都变得清晰。没有多余的回合，只有五个人对同一个瞬间的判断。';\n    var semi={\n      '美国':'半决赛遇上美国，声音会先一步压过球馆。那支被全世界注视的球队会用换防和速度不断试探你们，但你们已经走到这里，不需要把自己交给任何人的传说。姚明在内线吸引目光，弱侧的队友必须及时出现；每一次冷静的传球，都是中国队对这束灯光的回应。',\n      '西班牙':'半决赛遇上西班牙，比赛会像一根绷紧的弦。加索尔的身高、球队的传导和每一次耐心的移动，会把防守拖向更远的地方。你们要守住篮下，也要守住彼此的信任：有人被包夹时，另一双手必须已经准备好接住下一传。',\n      '阿根廷':'半决赛遇上阿根廷，场上不会有太多慌乱，只有一支成熟球队把每个细节做到极致。暂停后的第一个回合、最后一次轮转、篮板落下时谁先伸手，都会决定这场比赛的方向。你们把答案交给五个人，而不是交给某一个英雄。',\n      '立陶宛':'半决赛遇上立陶宛，旧日录像里的那些回合仿佛又亮了起来。但今天没有人站在过去里面，队友就在身边，球在手里，时间正向前走。把想说的话放进防守、篮板和每一次不退让的脚步里。',\n      '澳大利亚':'半决赛遇上澳大利亚，身体对抗会从第一分钟持续到最后一分钟。他们的轮换和篮板会把疲惫一层层压上来，真正托住你们的，是每次有人倒下后，身边立刻伸出的那只手。'\n    }[opponent]||knockout;\n    var final={\n      '美国':'决赛的另一端站着美国。全世界都在等待一场关于名字的较量，但你们更清楚，比赛从来不是由名字打完的。让每一次掩护、每一次回防和每一次传球都回到队友手里，五棵松会记住这支中国队如何把最后一场打到最后。',\n      '西班牙':'决赛的另一端站着西班牙。冠军级别的传导会让每一秒都显得珍贵，内线的对抗和弱侧的空位都需要全队同时看见。你们已经没有必要证明自己配得上这里，今晚只需要彼此靠近，再多守住一个回合。',\n      '阿根廷':'决赛的另一端站着阿根廷。两支熟悉关键时刻的球队会把比赛带进最细的缝隙里，谁更愿意多做一次无球跑动，谁就可能替队友打开那扇门。把紧张留在心里，把信任交给场上五个人。',\n      '立陶宛':'决赛的另一端站着立陶宛。过去的声音会从看台深处传来，但它不能替你们完成今天的任何一个回合。终场之前，所有答案都只在这块木地板上；你们要做的，是让队友知道身后永远有人。',\n      '澳大利亚':'决赛的另一端站着澳大利亚。篮下每一次碰撞都像在询问你们还能不能再坚持一步，而答案会来自五个人同时卡位、同时回防、同时把球传到最该出现的位置。'\n    }[opponent]||knockout;\n    if(stage==='八强赛')return knockout;\n    if(stage==='半决赛')return semi+' 看台的声音会一阵阵涌上来，但真正要听见的，始终是队友的呼喊和自己的脚步。';\n    if(stage==='决赛')return final+' 不必提前想象终场后的名字与掌声，先把眼前这一球交给队友，把这一刻打到最后。';\n    if(conditional)return conditional;\n    return (trailingLosses>=2?'连续的失利让更衣室安静了许多，但没有人提前离开。你们知道，今晚不需要先说服看台，只需要先让队友相信下一个回合。':'')+(group||'对手已经完成热身，球馆的灯光落到每一张熟悉的脸上。你和队友把手叠在一起，先把眼前这一回合做好。');}\n  function refreshDynamicRitual(){var m=document.querySelector('#match .match-ritual'),title=document.getElementById('match-title'),state=window.__olympicState;if(!m||!title||!title.textContent||!state||state.active==null)return;var game=(window.__olympicGames||[])[state.active],key=state.active+'|'+((state.records||[]).length);if(m.getAttribute('data-ritual-key')===key)return;m.textContent=matchRitualComplete(game,state.active);m.setAttribute('data-ritual-key',key)}\n  new MutationObserver(refreshDynamicRitual).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});\n  refreshDynamicRitual();\n  function refreshPregameRitual(){var cast=document.getElementById('gamecast'),state=window.__olympicState;if(!cast||!state||state.active==null)return;var log=cast.querySelector('.log'),game=(window.__olympicGames||[])[state.active],records=state.records||[],losses=records.slice(0,state.active).filter(function(item){return item&&!item.won}).length,wins=records.slice(0,state.active).filter(function(item){return item&&item.won}).length;if(!log||!game||log.textContent.indexOf('赛前仪式')<0)return;var key=state.active+'|'+records.length;if(log.getAttribute('data-pregame-key')===key)return;var opponent=game.opponent,body={\n    '美国':'美国队已经在另一侧排好队。你听见球鞋摩擦地板的声音，也听见看台上越来越清楚的欢呼。先别急着追赶他们的速度，先让每一次传球都找到自己的队友。',\n    '西班牙':'西班牙的球员围在一起做最后的提醒，声音不高，却很整齐。你把手放在队友肩上，知道今晚最重要的不是一个人打出答案，而是五个人一起把比赛的节奏握回来。',\n    '安哥拉':'安哥拉队的热身已经结束，场边留下连续起跳的回声。你们互相整理好球衣和护腕，像把紧张也一起整理妥当。哨声响起后，先从一次认真回防开始。',\n    '德国':'德国队的投篮一遍遍落进篮筐，球馆里的声音反而变得更安静。你看见队友点头，大家都明白：今晚也许没有很多轻松的回合，但每一次耐心的选择，都会替球队留住一点空间。',\n    '希腊':'希腊队在场边围成一圈，最后一次确认防守站位。你们也把手叠在一起，没人需要说太多。小组赛走到这里，疲惫是真的，可只要身边的人还在回应，脚步就不会停。',\n    '澳大利亚':'淘汰赛的灯光比小组赛更近，澳大利亚队已经站在中线另一侧。你听见队友深呼吸的声音，伸手拍了拍身边的人：从第一个篮板开始，把这支球队所有共同走过的东西带上场。',\n    '阿根廷':'阿根廷队安静地等待入场，像一支已经知道如何在关键时刻彼此信任的球队。你们没有回避这份重量，只把手叠在一起。今晚的每一次跑动，都是在告诉队友：你不是一个人。',\n    '立陶宛':'立陶宛队的绿色球衣在灯光下格外醒目。更衣室里没人再谈过去的比分，大家只确认眼前的对位和下一次补防。旧日留下的情绪，就用今晚一个个不后退的回合回答。'\n  }[opponent]||'对手已经完成热身，球馆的灯光落到每一张熟悉的脸上。你和队友把手叠在一起，先记住这份并肩站在这里的安静，然后把它带进第一回合。';if(losses>=2)body='前面的失利让你们更知道彼此需要什么。'+body;if(wins>=2&&losses===0)body='连续的胜利让看台开始期待，但你们知道，真正重要的仍是彼此之间的信任。'+body;log.innerHTML='<strong>赛前仪式</strong><br>'+body;log.setAttribute('data-pregame-key',key)}\n   new MutationObserver(refreshPregameRitual).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});\n   refreshPregameRitual();\n   function pregameRitualComplete(game,index){var state=window.__olympicState||{},records=state.records||[],games=window.__olympicGames||[],prior=records.slice(0,index),stage=game&&game.stage||'小组赛',opponent=game&&game.opponent||'',wins=prior.filter(function(item){return item&&item.won}).length,previousGame=games[index-1],previousRecord=prior[prior.length-1];var opening=stage==='小组赛'?'国歌声刚刚落下，双方首发站回各自半场。教练组把最后一句提醒压低到只有队友听得见，你也在这一刻把呼吸调整到比赛的节拍。':'淘汰赛入场通道的灯光比平时更近。工作人员退到边线之外，队友依次碰拳、点头，最后一遍确认对位，然后把这块场地交给你们。';var scene={\n     '美国':'美国队已经在另一侧排好队，球鞋摩擦地板的声音一下一下传过来。你看见队友把手放在胸前，没人需要提醒这场比赛的分量。','西班牙':'西班牙队围在一起做最后的提醒，声音不高，却整齐得像一段熟悉的节拍。你把手放在队友肩上，等裁判示意入场。','安哥拉':'安哥拉队的热身已经结束，篮筐还在轻轻摇晃。你们互相整理好球衣和护腕，把所有紧张收进一个简单的动作：先从认真回防开始。','德国':'德国队的投篮一遍遍落进篮筐，球馆里的声音反而安静下来。诺维茨基在另一端完成最后一次热身，你听见队友短促的呼吸，知道每个人都已准备好守住自己的位置。','希腊':'希腊队在场边围成一圈，最后一次确认防守站位。你们也把手叠在一起，没人需要说太多，小组赛走到这里，最可靠的语言仍然是彼此的回应。','澳大利亚':'澳大利亚队已经站在中线另一侧，裁判在检查记录台。你伸手拍了拍身边的人，从第一个篮板开始，把所有人的脚步放在同一个方向。','阿根廷':'阿根廷队安静地等待入场，队员之间用眼神完成最后确认。你低头看了看鞋带，又抬头看向队友：关键时刻没有捷径，只有每个人都准时出现。','立陶宛':'立陶宛队的白绿色球衣在灯光下很醒目，记录台开始倒数。你没有再看过去的声音，只把手伸向队友，等大家一起跨过中线。'}[opponent]||'对手已经完成热身，记录台亮起最后一盏灯。你和队友围成一圈，先记住身边这些熟悉的声音。';if(stage==='小组赛'&&opponent==='安哥拉'&&prior.length>=2&&previousRecord){scene=previousRecord.won?'上一场终场后，队友没有在更衣室里停留太久。今天重新走进球馆，大家的动作更快、更安静，像是已经知道要把那股重新找回来的力量放在哪里。':'前两场的结果没有从更衣室消失，但它们也没有把你们拆开。入场前，队友依次碰拳，像是在告诉彼此：这一次不需要谁独自承担。'}if(stage==='小组赛'&&opponent==='德国'&&previousGame&&previousGame.opponent==='安哥拉'&&previousRecord){scene=previousRecord.won?'安哥拉之后的胜利让更衣室重新有了笑声，但现在笑声停在门内。你们把注意力收回到最后一次对位确认，准备迎接更沉、更慢的四节。':'教练组把最后一次战术板确认得很慢，没人把前一场的失落带到队友身上。门一打开，所有人同时抬头，准备从第一步防守开始。'}if(stage==='小组赛'&&opponent==='希腊'){scene=wins>=3?'排名的计算声从看台传来，但场边没有人分心。你们在入场前围成一圈，约定把外面的声音留在门外，只回应每一次队友的呼喊。':'这是小组赛最后一场。有人把毛巾递给你，有人替你确认鞋带，大家都知道今晚不能把任何一个队友留在压力里。'}return opening+' '+scene+' 哨声响起前，先把手叠在一起，等第一球来到你们面前。'}\n   pregameRitualComplete=function(game,index){var state=window.__olympicState||{},records=state.records||[],games=window.__olympicGames||[],prior=records.slice(0,index),stage=game&&game.stage||'小组赛',opponent=game&&game.opponent||'',wins=prior.filter(function(item){return item&&item.won}).length,previousGame=games[index-1],previousRecord=prior[prior.length-1];var lines={\n     '美国':'国歌声刚落，美国队的脚步声已经从另一侧传来。你把手放回队友掌心，等第一声哨响。',\n     '西班牙':'西班牙队围成一圈，最后确认一次传导路线。你和队友没有多说，只把目光同时投向中线。',\n     '安哥拉':'你们在场边重新系紧鞋带，前两场留下的情绪被收进这个动作里。五个人碰拳，准备从第一个篮板开始。',\n     '德国':'德国队的投篮声一下一下落进篮筐。你听见队友喊出防守站位，所有人同时抬头。',\n     '希腊':'希腊队的最后一次站位确认结束。你们把手叠在一起，疲惫没有被说出口，却被彼此稳稳接住。',\n     '澳大利亚':'澳大利亚队站在中线另一侧，记录台亮起最后一盏灯。你拍了拍队友，准备为同一个篮板起跳。',\n     '阿根廷':'阿根廷队用一个眼神完成最后对位。你把球交给裁判，再把手伸向身边的人。',\n     '立陶宛':'立陶宛的白绿色球衣映在灯光里。你没有回头，只和队友一起跨过中线。'\n   }[opponent]||'记录台亮起最后一盏灯。你和队友围成一圈，等比赛把答案交到场上。';if(stage!=='小组赛')lines=(stage==='八强赛'?'八强赛的入场通道很安静。':stage==='半决赛'?'半决赛的灯光压得很低。':'决赛的国歌声在球馆上空停留了很久。')+' '+lines;if(stage==='小组赛'&&opponent==='安哥拉'&&prior.length>=2&&previousRecord&&!previousRecord.won)lines='前两场的失落没有让更衣室散开。入场前，队友依次碰拳，准备把第一个回合打给彼此看。';if(stage==='小组赛'&&opponent==='德国'&&previousGame&&previousGame.opponent==='安哥拉'&&previousRecord)lines=previousRecord.won?'安哥拉之后的笑声停在更衣室门内。你们整理好护腕，准备迎接一场更沉的比赛。':'更衣室里没人把上一场的失落带给队友。门打开，大家同时走向自己的位置。';if(stage==='小组赛'&&opponent==='希腊'&&wins>=3)lines='看台已经开始计算下一轮，但你们把声音留在门外。最后一次碰拳后，只回应队友的呼喊。';return lines}\n   function refreshPregameRitualComplete(){var cast=document.getElementById('gamecast'),state=window.__olympicState;if(!cast||!state||state.active==null)return;var log=cast.querySelector('.log'),game=(window.__olympicGames||[])[state.active],records=state.records||[],key=state.active+'|'+records.length;if(!log||!game||log.textContent.indexOf('赛前仪式')<0||log.getAttribute('data-pregame-complete-key')===key)return;var body=pregameRitualComplete(game,state.active);log.innerHTML='<strong>赛前仪式</strong><br>'+body;log.setAttribute('data-pregame-complete-key',key)}\n   new MutationObserver(refreshPregameRitualComplete).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});\n   refreshPregameRitualComplete();\n  function refreshGroupSummary(){var note=document.getElementById('group-summary-note'),copy=document.getElementById('group-summary-copy'),state=window.__olympicState;if(!note||!copy||!state)return;var records=state.records||[],wins=records.filter(function(item){return item&&item.won}).length;if(records.length<5)return;var games=window.__olympicGames||[],qf=wins>=4?'澳大利亚':(wins===3?'阿根廷':'立陶宛');copy.textContent=wins>=2?'五场比赛把你们带到同一条路上。有人在逆风里咬住比分，有人在最后一攻前把球传给队友。没有人急着庆祝，大家已经开始准备下一场。':'五场比赛结束了。你们没有走到下一轮，但这段夏天并没有被一个排名带走。每一次穿上国家队球衣的时刻，都已经留下。';note.textContent=wins>=2?'下一场：八强赛 · '+qf+'。带着五场比赛留下的勇气，继续走。':'本次奥运篇章到此结束。你们已经为这座球馆留下了自己的声音。'}\n  function enhanceGroupSummary(){var section=document.getElementById('group-summary'),copy=document.getElementById('group-summary-copy'),note=document.getElementById('group-summary-note'),title=section&&section.querySelector('h2'),state=window.__olympicState;if(!section||!section.classList.contains('active')||!copy||!note||!state||(state.records||[]).length<5)return;var wins=(state.records||[]).filter(function(item){return item&&item.won}).length;if(section.getAttribute('data-enhanced')===String(wins))return;var qf=wins>=4?'澳大利亚':(wins===3?'阿根廷':'立陶宛');if(title)title.textContent='五场之后，灯光仍在';copy.innerHTML=wins>=2?'<p>五场比赛，像五次把心跳交给同一块木地板。你们在掌声里学会沉住气，也在落后时学会彼此靠近。有人替队友补上空位，有人把最后一口气留给回防，所有没有被记分牌写下的努力，都在这一刻汇成了同一个方向。</p><p>小组赛到这里暂告一段落，但这不是一扇关上的门。五棵松的灯光还亮着，队友的手还叠在一起。下一场，你们将带着这五场比赛留下的勇气，继续走进更大的回声里。</p>':'<p>五场比赛终于走完。你们经历过欢呼，也经历过比分一点点被追近的时刻；经历过手感冰冷的夜晚，也经历过队友在你身边一次又一次喊出名字。</p><p>这一段路没有被一个结果定义。球衣上的国旗、通道里的脚步声、终场后仍然没有松开的手，都属于你们共同走过的北京夏天。</p>';note.textContent=wins>=2?'下一场：八强赛 · '+qf+'。请把今天的掌声收进心里，把明天的每一次拼抢留在场上。':'本次奥运篇章暂告一段落。请带着这段共同走过的夏天，离开球馆。';section.setAttribute('data-enhanced',String(wins))}\n  new MutationObserver(enhanceGroupSummary).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});\n  function customizeGroupSummary(){var section=document.getElementById('group-summary'),copy=document.getElementById('group-summary-copy'),record=document.getElementById('group-summary-record'),note=document.getElementById('group-summary-note'),button=document.getElementById('group-summary-btn'),state=window.__olympicState;if(!section||!section.classList.contains('active')||!copy||!record||!note||!button||!state||(state.records||[]).length<5)return;var wins=(state.records||[]).filter(function(item){return item&&item.won}).length,losses=5-wins,qf=wins>=4?'澳大利亚':(wins===3?'阿根廷':'立陶宛'),key=wins+'-'+qf;if(section.getAttribute('data-custom-copy')===key)return;var copyText=wins>=4?'<p>五场比赛，你们把每一次上场都变成了彼此靠近的理由。领先时