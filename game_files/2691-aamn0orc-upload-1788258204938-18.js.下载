      '#screen-historical-award-compare .history-hotplug-award-line{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:5px;min-height:27px;border-bottom:1px solid var(--border-light,#f1e6d8);font-size:12px;color:var(--text,#32261e);}' +
