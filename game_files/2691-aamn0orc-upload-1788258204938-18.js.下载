    document.head.appendChild(style);
    var screen = document.createElement('div');
    screen.className = 'screen';
    screen.id = SCREEN_ID;
    screen.innerHTML = '<div class="section-title"><h1>历史荣誉对照</h1><div class="sub">从你踏入联盟的那一年，到现在</div></div><div id="historical-award-compare-content"></div>';
    // 放回主容器，避免 #app 的整屏最小高度把动态页面挤到首屏之外。
    (document.getElementById('app') || document.body).appendChild(screen);
    injected = true;
  }
  function render() {
    injectAssets();
    var count = seasonCount();
    var start = baseYear();
    var annualRows = annualStarComparison(count);
    // 只保留当前完成的这一年，避免页面纵向堆叠整个生涯。
    annualRows = annualRows.length ? [annualRows[annualRows.length - 1]] : [];
    // 顶部“我的荣誉”与球星对照采用相同的累计口径。
    var ownTotals = aggregateOwnAwards(count);
    var content = document.getElementById('historical-award-compare-content');
    if (!content) return;
    var rowsHtml = annualRows.map(function (annual) {
      var playerRows = annual.players.map(function (row) {
        var awardRows = row.awardRows || [];
        var gameLines = awardRows.map(function (award) {
          var deltaClass = award.delta < 0 ? ' is-behind' : (award.delta > 0 ? ' is-ahead' : '');
          var deltaText = '(' + (award.delta > 0 ? '+' : '') + award.delta + ')';
          return '<div class="history-hotplug-award-line"><span>' + esc(award.label) + '</span><strong>' + award.gameCount + ' 次</strong><em class="history-hotplug-delta' + deltaClass + '">' + deltaText + '</em></div>';
        }).join('');
        var realLines = awardRows.map(function (award) {
          return '<div class="history-hotplug-award-line"><span>' + esc(award.label) + '</span><strong>' + award.realCount + ' 次</strong></div>';
        }).join('');
        if (!awardRows.length) {
          gameLines = '<div class="history-hotplug-award-line"><span>无荣誉</span></div>';
          realLines = '<div class="history-hotplug-award-line"><span>无荣誉</span></div>';
        }
        return '<div class="history-hotplug-row"><div class="history-hotplug-cell"><div class="history-hotplug-cell-label">游戏时间线 · ' + esc(row.name) + '</div><div class="history-hotplug-award-list">' + gameLines + '</div></div><div class="history-hotplug-cell history-original"><div class="history-hotplug-cell-label">现实历史 · ' + esc(row.name) + '</div><div class="history-hotplug-award-list">' + realLines + '</div></div></div>';
      }).join('');
      return '<div class="history-hotplug-year"><div class="history-hotplug-year-title">' + esc(annual.key) + '</div>' + playerRows + '</div>';
    }).join('');
    // 历史对照页是赛季收束后的最后一页，下一步统一进入休赛期。
    var next = '<button class="btn btn-primary" onclick="beginOffseason()">进入休赛期</button>';
    career()._historicalAwardCompareViewedSeason = seasonCount();
    if (typeof window.saveState === 'function') try { window.saveState(); } catch (e) {}
    window.showScreen(SCREEN_ID);
    var ownDetail = Object.keys(ownTotals).map(function (label) { return label + ' ' + ownTotals[label] + ' 次'; }).join('、') || '截至目前暂无个人荣誉';
    content.innerHTML = '<div class="history-hotplug"><div class="history-hotplug-head"><div class="history-hotplug-kicker">累计至 · ' + esc(annualRows.length ? annualRows[0].key : seasonKey(count)) + '</div><h2>我的荣誉</h2><p>' + esc(userName()) + '从游戏开始赛季至今获得的荣誉，以及这段时间被你改写的历史。</p><div class="history-hotplug-my-awards">' + esc(ownDetail) + '</div></div><div class="history-hotplug-compare"><div class="history-hotplug-compare-title">截至本赛季累计：年代球星游戏中荣誉 对比 现实荣誉</div>' + rowsHtml + '</div><div class="history-hotplug-actions">' + next + '</div></div>';
  }
  function due() {
    var count = seasonCount();
    return API.enabled && isRegularSeasonComplete() && isChampionDecided() && count > 0 && baseYear() > 0 &&
      parseInt(career()._historicalAwardCompareViewedSeason, 10) !== count;
  }

  // 每个赛季只展示一次入口，页面跳转仍由用户点击完成。
  API.enable = function () { API.enabled = true; };
  API.disable = function () { API.enabled = false; };
  API.show = render;
  API.isDue = due;
  window.showHistoricalAwardComparison = function () { API.show(); };
  window.HISTORICAL_AWARD_COMPARE_HOTPLUG = API;
})(window, document);
