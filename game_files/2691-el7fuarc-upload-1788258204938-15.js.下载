(function() {
  'use strict';

  var historicalPlayerNamesCache = null;

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function escapeRegExp(value) {
    return String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function normalizeStory(story) {
    return String(story == null ? '' : story)
      .replace(/\\n/g, '\n')
      .replace(/\r/g, '')
      .replace(/[ \t]+/g, '')
      .replace(/[ \t]*-[ \t]*/g, '-')
      .replace(/[ \t]*([，。；：！？、（）()])[ \t]*/g, '$1')
      .trim();
  }

  function compactStory(story) {
    var paragraphs = normalizeStory(story)
      .split(/\n\s*\n/)
      .map(function(paragraph) { return paragraph.trim(); })
      .filter(Boolean)
      .slice(0, 2);

    var cleaned = paragraphs.map(function(paragraph) {
      var sentences = paragraph.match(/[^。！？!?]+[。！？!?]?/g) || [paragraph];
      return sentences.filter(function(sentence) {
        var text = sentence.trim();
        return !/^这一年的荣誉把球队推到联盟聚光灯下/.test(text) &&
          !/^这一年的聚光灯落在/.test(text) &&
          !/^这些奖项并不是一个人独自完成的/.test(text) &&
          !/^这套核心名单里，有人负责得分/.test(text) &&
          !/^他们没有把故事写到最后一场/.test(text) &&
          !/^他们还没有把所有可能性兑现/.test(text) &&
          !/^球权、轮换和更衣室里的信任都还在流动/.test(text) &&
          !/^你的答案要在真实的对位和关键回合里出现/.test(text) &&
          !/^你不是来把过去改写成一片空白/.test(text) &&
          !/^如果从看台最远的一排望过去/.test(text) &&
          !/^城市记住的是比赛，球员记住的是比赛之前的那些细节/.test(text) &&
          !/^勇士创下73胜/.test(text) &&
          !/^爵士第一次把自己送到总决赛门口/.test(text);
      });
    });

    var context = (cleaned[0] || []).slice(0, 2);
    var impactSource = cleaned[1] || [];
    var impact = impactSource.length > 2 ? impactSource.slice(-2) : impactSource;
    if (!context.length && impact.length) context = impact.slice(0, 1);
    if (!impact.length && cleaned[0]) impact = cleaned[0].slice(2, 4);
    return [context.join('').trim(), impact.join('').trim()].filter(Boolean);
  }

  function getHistoricalPlayerNames() {
    if (historicalPlayerNamesCache) return historicalPlayerNamesCache;
    var names = [];
    var addName = function(name, addShortName) {
      if (typeof name !== 'string') return;
      name = name.trim();
      if (name.length < 2 || names.indexOf(name) >= 0) return;
      names.push(name);
      if (addShortName && name.indexOf('-') >= 0) {
        var parts = name.split('-');
        var surname = parts[parts.length - 1].trim();
        var givenName = parts[0].trim();
        if (surname.length >= 2 && surname !== '二世') addName(surname, false);
        if (givenName.length >= 2) addName(givenName, false);
      }
    };
    var addRecord = function(player) {
      if (!player || typeof player !== 'object') return;
      ['cn', 'cname', 'nameCN', 'displayName', 'name'].forEach(function(field) {
        addName(player[field], true);
      });
    };
    var collect = function(value, depth) {
      if (!value || depth > 4) return;
      if (Array.isArray(value)) {
        value.forEach(function(item) {
          addRecord(item);
          collect(item, depth + 1);
        });
        return;
      }
      if (typeof value !== 'object') return;
      addRecord(value);
      ['players', 'rosters', 'seasons'].forEach(function(field) {
        if (value[field]) collect(value[field], depth + 1);
      });
    };
    collect(window.HISTORICAL_PLAYERS, 0);
    collect(window.CAREER_SEASON_DATA, 0);
    collect(window.NBA2K_DATA, 0);
    historicalPlayerNamesCache = names.sort(function(a, b) { return b.length - a.length; });
    return historicalPlayerNamesCache;
  }

  function renderStoryText(text) {
    var names = getHistoricalPlayerNames().filter(function(name) {
      return text.indexOf(name) >= 0;
    });
    if (!names.length) return escapeHtml(text);

    var pattern = new RegExp('(' + names.map(escapeRegExp).join('|') + ')', 'g');
    return text.split(pattern).map(function(part) {
      if (names.indexOf(part) >= 0) {
        return '<strong>' + escapeHtml(part) + '</strong>';
      }
      return escapeHtml(part);
    }).join('');
  }

  function getStory(team, teamName, state) {
    if (!window.LEGEND_TEAM_SEASON_STORIES || !state) return '';
    if (state.draftMode !== 'historical' && state.mode !== 'legend') return '';
    var season = state.careerSeason ? String(state.careerSeason) : '';
    if (!season && state.eraStart) {
      var eraYear = parseInt(state.eraStart, 10);
      if (Number.isFinite(eraYear)) season = eraYear + '-' + String((eraYear + 1) % 100).padStart(2, '0');
    }
    if (!season) return '';
    teamName = teamName || (typeof window.getTeamName === 'function' ? window.getTeamName(team) : team);
    var stories = window.LEGEND_TEAM_SEASON_STORIES;
    var exact = stories[season + '|' + teamName] || stories[season + '|' + team];
    if (exact) return exact;
    var standardNames = {
      ATL:'亚特兰大老鹰', BOS:'波士顿凯尔特人', BKN:'新泽西篮网', CHA:'夏洛特黄蜂', CHI:'芝加哥公牛',
      CLE:'克利夫兰骑士', DAL:'达拉斯小牛', DEN:'丹佛掘金', DET:'底特律活塞', GSW:'金州勇士',
      HOU:'休斯敦火箭', IND:'印第安纳步行者', LAC:'洛杉矶快船', LAL:'洛杉矶湖人', MEM:'温哥华灰熊',
      MIA:'迈阿密热火', MIL:'密尔沃基雄鹿', MIN:'明尼苏达森林狼', NYK:'纽约尼克斯', OKC:'俄克拉荷马城雷霆',
      ORL:'奥兰多魔术', PHI:'费城76人', PHX:'菲尼克斯太阳', POR:'波特兰开拓者', SAC:'萨克拉门托国王',
      SAS:'圣安东尼奥马刺', TOR:'多伦多猛龙', UTA:'犹他爵士', WAS:'华盛顿奇才'
    };
    var standardName = standardNames[team];
    if (standardName && stories[season + '|' + standardName]) return stories[season + '|' + standardName];
    var aliases = {
      '华盛顿子弹': '华盛顿奇才',
      '新泽西篮网': '新泽西篮网',
      '夏洛特山猫': '夏洛特黄蜂',
      '西雅图超音速': '西雅图超音速',
      '温哥华灰熊': '温哥华灰熊'
    };
    var alias = aliases[teamName];
    return alias ? (stories[season + '|' + alias] || '') : '';
  }

  function injectStory(team, teamName, state) {
    var story = getStory(team, teamName, state);
    if (!story || document.getElementById('legend-team-story-modal')) return false;
    var paragraphs = compactStory(story);
    var overlay = document.createElement('div');
    overlay.className = 'team-picker-overlay legend-team-story-overlay';
    overlay.id = 'legend-team-story-modal';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.innerHTML = '<div class="team-picker-modal legend-team-story-modal" style="max-width:440px;max-height:86vh;">' +
      '<div class="team-picker-header"><span>球队选择确认</span><button class="btn btn-sm" style="width:30px;height:30px;padding:0;" aria-label="关闭" onclick="closeLegendTeamStory()">✕</button></div>' +
      '<div style="padding:16px 18px 8px;text-align:left;overflow-y:auto;">' +
      '<div class="legend-team-story-kicker">' + escapeHtml(state.careerSeason) + ' - 球队历史节点</div>' +
      '<div class="legend-team-story-body">' + paragraphs.map(function(paragraph) {
        return '<p>' + renderStoryText(paragraph).replace(/\n/g, '<br>') + '</p>';
      }).join('') + '</div>' +
      '<div style="padding:8px 18px 18px;"><button class="btn btn-primary" style="width:100%;" onclick="closeLegendTeamStory()">进入球队</button></div>' +
      '</div>';
    overlay.addEventListener('click', function(event) {
      if (event.target === overlay) closeLegendTeamStory();
    });
    document.body.appendChild(overlay);
    return true;
  }

  window.closeLegendTeamStory = function() {
    var modal = document.getElementById('legend-team-story-modal');
    if (modal) modal.remove();
  };

  var style = document.createElement('style');
  style.textContent = '.legend-team-story-overlay{z-index:520}.legend-team-story-modal{overflow:hidden}.legend-team-story-kicker{margin-bottom:12px;color:var(--orange);font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:1px}.legend-team-story-body{color:var(--text);font-size:13px;line-height:1.9}.legend-team-story-body p{margin:0}.legend-team-story-body p+p{margin-top:13px}';
  document.head.appendChild(style);

  window.renderLegendTeamStory = injectStory;
})();
